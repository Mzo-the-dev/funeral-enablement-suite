{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EverBond Web (port 5322)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/mobile/lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": ["--web-port", "5322"]
    },
    {
      "name": "Attach to Nest API",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}