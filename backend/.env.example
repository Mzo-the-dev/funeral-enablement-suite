# Copy to .env for local development. Do not commit .env or use these settings in production.
DATABASE_URL=postgresql://localhost/funeral_spaces_dev
API_PORT=3000
CORS_ORIGINS=http://localhost:5322,http://127.0.0.1:5322

# Generate each secret locally with: openssl rand -hex 32
OTP_PEPPER=replace-with-a-random-secret-of-at-least-32-characters

# Local-only sink: returns the generated code in the registration API response.
# This is not email/SMS delivery and must remain false outside local development.
DEV_RETURN_OTP=true
